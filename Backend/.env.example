# Copy to .env (git-ignored) and fill in. Loaded by scripts/run-backend.sh
SPRING_PROFILES_ACTIVE='dev'
SERVER_PORT='8080'
SPRING_DATASOURCE_URL='jdbc:mysql://127.0.0.1:3310/PROVEYU?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8'
SPRING_DATASOURCE_USERNAME='proveyu'
SPRING_DATASOURCE_PASSWORD='change-me'
JWT_SECRET='change-me-to-a-random-64-plus-character-secret-generated-with-openssl-rand'
SPRING_MAIL_HOST='smtpout.secureserver.net'
SPRING_MAIL_PORT='465'
SPRING_MAIL_USERNAME=''
SPRING_MAIL_PASSWORD=''
CORS_ALLOWED_ORIGINS='http://localhost:4200'
APP_FRONTEND_URL='http://localhost:4200'
APP_DEV_EXPOSE_TOKENS='true'
COLLEGE_REQUIRE_APPROVAL='false'

# AI interview cloud (Groq, free key from console.groq.com). Blank = local Ollama + whisper.cpp only.
# Several keys, comma-separated (gsk_aaa,gsk_bbb,gsk_ccc): used in turn, and a key at its rate limit is skipped until it recovers.
GROQ_API_KEY=
# Local AI models (Ollama, whisper.cpp, Piper from ai-services): true = backup when every Groq key fails;
# false = Groq only (no local services needed; the browser reads questions aloud).
AI_LOCAL_MODELS_ENABLED=true
# CXO portal (college leadership dashboards). Its own Groq key; blank = dashboards are planned by rules (no AI).
CXO_GROQ_API_KEY=
CXO_AI_MODEL=openai/gpt-oss-120b

# Off-campus jobs: nightly import of fresher jobs and internships (key from a Careerjet publisher account). Blank = no import.
CAREERJET_API_KEY=
# The website URL you declared in the Careerjet publisher account (Careerjet checks it), e.g. https://proveyu.com
CAREERJET_REFERER=

# AI interview purchases by UPI QR: your UPI ID (e.g. proveyu@okaxis). Blank = students cannot buy yet.
UPI_ID=
UPI_PAYEE_NAME=ProveYu
# First platform admin (only when no admin exists yet). Remove both after the first start.
ADMIN_BOOTSTRAP_EMAIL=''
ADMIN_BOOTSTRAP_PASSWORD=''
# Help & support requests are also e-mailed here (leave empty to use only the admin portal)
SUPPORT_INBOX_EMAIL=''
