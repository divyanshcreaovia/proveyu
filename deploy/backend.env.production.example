# Production settings for the backend on EC2. Copy to /etc/proveyu/backend.env, chmod 600, owned by the proveyu user.
# Every secret here must be NEW for production: do not reuse the development values.

# ---- never "dev" in production: the dev profile returns OTPs and invite tokens in API responses
SPRING_PROFILES_ACTIVE=prod
APP_DEV_EXPOSE_TOKENS=false
COLLEGE_REQUIRE_APPROVAL=true
SPRINGDOC_ENABLED=false

# ---- network: only nginx (same server) talks to the backend
SERVER_PORT=8080
SERVER_ADDRESS=127.0.0.1
TRUSTED_PROXIES=127.0.0.1
FORWARD_HEADERS_STRATEGY=native
CORS_ALLOWED_ORIGINS=https://proveyu.example.com
APP_FRONTEND_URL=https://proveyu.example.com

# ---- database: an app user with rights on this one database only (not root), strong random password
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/proveyufinaldb?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=proveyu_app
SPRING_DATASOURCE_PASSWORD=
# openssl rand -base64 64   (a new secret signs every token out)
JWT_SECRET=

# ---- Flyway: the database was created from finaluseddbschema.sql (Flyway version 39). Flyway marks it as 39 on the first start
# and from then on runs only newer migrations (V40, V41, ...) on each start. Keep this equal to the version at the top of that file.
SPRING_FLYWAY_BASELINE_VERSION=39
JWT_EXPIRATION_MS=86400000

# ---- first admin: a strong, NEW password (Admin@1234 is in the repository). Remove both lines after the first start.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Platform Admin

# ---- mail
SPRING_MAIL_HOST=smtpout.secureserver.net
SPRING_MAIL_PORT=465
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SUPPORT_INBOX_EMAIL=

# ---- AI interview and job import
GROQ_API_KEY=
AI_LOCAL_MODELS_ENABLED=false
INTERVIEW_CLOUD_MAX_PARALLEL=8
CAREERJET_API_KEY=
CAREERJET_REFERER=https://proveyu.example.com

# ---- sign-in rate limit per client address (a whole college lab can share one address: raise for big drives)
AUTH_LIMIT_PER_MINUTE=60

# ---- files live outside the code folder, on the data volume
FILE_UPLOAD_DIR=/var/lib/proveyu/uploads/resumes
CHAT_FILE_UPLOAD_DIR=/var/lib/proveyu/uploads/chat
COLLEGE_FILE_UPLOAD_DIR=/var/lib/proveyu/uploads/college
INTERVIEW_AUDIO_DIR=/var/lib/proveyu/uploads/interviews
PREP_PROCTOR_DIR=/var/lib/proveyu/uploads/proctor
