{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "proveyu-frontend": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "vision_wasm_internal.{js,wasm}",
                "input": "node_modules/@mediapipe/tasks-vision/wasm",
                "output": "proctor/mediapipe"
              },
              {
                "glob": "{vad.worklet.bundle.min.js,silero_vad_v5.onnx}",
                "input": "node_modules/@ricky0123/vad-web/dist",
                "output": "proctor/vad"
              },
              {
                "glob": "ort-wasm-simd-threaded.{wasm,mjs}",
                "input": "node_modules/onnxruntime-web/dist",
                "output": "proctor/ort"
              }
            ],
            "styles": [
              "src/styles.scss"
            ],
            "allowedCommonJsDependencies": [
              "qrcode",
              "@ricky0123/vad-web",
              "onnxruntime-web",
              "onnxruntime-web/wasm"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "700kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "60kB",
                  "maximumError": "80kB"
                }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "src/app/core/environments/environment.ts",
                  "with": "src/app/core/environments/environment.prod.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "proveyu-frontend:build:production"
            },
            "development": {
              "buildTarget": "proveyu-frontend:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
